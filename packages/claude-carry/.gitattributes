# NOTE: the LAST matching pattern wins, so the general rule goes FIRST and the
# specific overrides come after it.

# Default: normalize to LF in the repo.
* text=auto eol=lf

# Windows batch files MUST be CRLF or cmd.exe misparses them (seen as a spurious
# "'M' is not recognized" error).
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell: keep CRLF on Windows for consistency.
*.ps1 text eol=crlf
