{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runsteward.local/contracts/runsteward/v1/choicegate-qualification.schema.json",
  "title": "RunSteward frozen ChoiceGate qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "verifier", "receipt_schema_id", "receipt_schema_ref",
    "receipt_schema_sha256", "receipt_schema_source_raw_sha256", "choicegate_commit",
    "choicegate_tree", "lifecycle_authority_commit", "lifecycle_authority_state_model",
    "lifecycle_inventory_fingerprint", "provenance_ref", "receipts", "qualification_digest"
  ],
  "properties": {
    "schema_version": { "const": "runsteward.choicegate-qualification/v1" },
    "verifier": { "const": "runsteward-choicegate-python-qualification/v1" },
    "receipt_schema_id": { "const": "choicegate.decision-receipt/v1" },
    "receipt_schema_ref": { "$ref": "common.schema.json#/$defs/relativeRef" },
    "receipt_schema_sha256": { "const": "3d32d4bac2cb9ff78d0249741d74e8572326894435e3bab10bf0f2f7ca7c949d" },
    "receipt_schema_source_raw_sha256": { "const": "c21949ee1a0fcf80d550d22b541123bbd31c5c424c92f819ee9cfa409827b69f" },
    "choicegate_commit": { "$ref": "common.schema.json#/$defs/gitCommit" },
    "choicegate_tree": { "$ref": "common.schema.json#/$defs/gitCommit" },
    "choicegate_acceptance_receipt_sha256": { "$ref": "common.schema.json#/$defs/bareSha256" },
    "lifecycle_authority_commit": { "$ref": "common.schema.json#/$defs/gitCommit" },
    "lifecycle_authority_tree": { "$ref": "common.schema.json#/$defs/gitCommit" },
    "lifecycle_authority_state_model": { "const": "orthogonal-seven-axis-v1" },
    "lifecycle_inventory_fingerprint": { "$ref": "common.schema.json#/$defs/bareSha256" },
    "lifecycle_authority_fingerprint": { "$ref": "common.schema.json#/$defs/bareSha256" },
    "provenance_ref": { "$ref": "common.schema.json#/$defs/artifactRef" },
    "receipts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "immutable_ref", "raw_bytes_sha256", "normalized_utf8_lf_sha256", "receipt_sha256", "request_sha256", "schema_id", "choicegate_commit", "qualification_status"],
        "properties": {
          "case_id": { "$ref": "common.schema.json#/$defs/choicegateStableId" },
          "immutable_ref": { "$ref": "common.schema.json#/$defs/relativeRef" },
          "raw_bytes_sha256": { "$ref": "common.schema.json#/$defs/bareSha256" },
          "normalized_utf8_lf_sha256": { "$ref": "common.schema.json#/$defs/bareSha256" },
          "receipt_sha256": { "$ref": "common.schema.json#/$defs/bareSha256" },
          "request_sha256": { "$ref": "common.schema.json#/$defs/bareSha256" },
          "schema_id": { "const": "choicegate.decision-receipt/v1" },
          "choicegate_commit": { "$ref": "common.schema.json#/$defs/gitCommit" },
          "qualification_status": { "const": "passed" }
        }
      }
    },
    "qualification_digest": { "$ref": "common.schema.json#/$defs/runstewardDigest" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "choicegate_commit": { "const": "c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1" }
        },
        "required": ["choicegate_commit"]
      },
      "then": {
        "required": [
          "choicegate_acceptance_receipt_sha256",
          "lifecycle_authority_tree",
          "lifecycle_authority_fingerprint"
        ]
      }
    }
  ]
}
