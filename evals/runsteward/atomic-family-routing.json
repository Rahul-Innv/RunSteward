  "runtime_parity_cases": [
    {
      "id": "parallel-independent-leases",
      "area": "concurrency",
      "source_test": "packages/runsteward-core/test/scheduler.test.mjs",
      "invariant": "distinct tasks allocate unique run, branch, worktree, state, evidence, and lease identities"
    },
    {
      "id": "scheduler-lost-update",
      "area": "concurrency",
      "source_test": "packages/runsteward-core/test/scheduler.test.mjs",
      "invariant": "coordination lock and prior digest prevent concurrent lost updates"
    },
    {
      "id": "pre-rename-write-failure",
      "area": "failure",
      "source_test": "packages/runsteward-core/test/atomic-write.test.mjs",
      "invariant": "old complete state survives and failed temporary state is removed"
    },
    {
      "id": "child-blocked-independent",
      "area": "failure",
      "source_test": "packages/runsteward-core/test/child-join.test.mjs",
      "invariant": "blocked child cannot satisfy wait or join and cannot claim parent completion"
    },
    {
      "id": "checkpoint-resume-verified",
      "area": "checkpoint-resume",
      "source_test": "packages/runsteward-core/test/invariants.test.mjs",
      "invariant": "verified plus digest requires released predecessor and distinct active successor lease"
    },
    {
      "id": "checkpoint-resume-not-required",
      "area": "checkpoint-resume",
      "source_test": "packages/runsteward-adapter-claude-code/test/adapter.test.mjs",
      "invariant": "not-required plus null is the only non-verified resumable provider binding"
    },
    {
      "id": "budget-metrics-nonconvertible",
      "area": "budget-metric",
      "source_test": "packages/runsteward-core/test/provider-evidence.test.mjs",
      "invariant": "Claude percentages, burn rates, and Codex tokens preserve typed units and are never converted"
    },
    {
      "id": "unknown-budget-nonauthorizing",
      "area": "budget-metric",
      "source_test": "packages/runsteward-core/test/provider-evidence.test.mjs",
      "invariant": "unknown evidence carries no numeric metric and authorizes no wrap or resume"
    },
    {
      "id": "bounded-redacted-evidence",
      "area": "raw-evidence",
      "source_test": "packages/runsteward-core/test/provider-evidence.test.mjs",
      "invariant": "raw evidence is retained only behind bounded redacted references"
    },
    {
      "id": "cancel-retains-evidence",
      "area": "failure",
      "source_test": "packages/runsteward-core/test/invariants.test.mjs",
      "invariant": "cancelled is terminal with final proof and never hard deletion"
    }
  ]
}
